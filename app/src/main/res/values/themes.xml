<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Paleta do app -->
    <color name="peach">#E6B39A</color>
    <color name="sand">#E6CBA5</color>
    <color name="cream">#EDE3B4</color>
    <color name="sage">#8B9E9B</color>
    <color name="slate">#6D7578</color>

    <!--
        Visual limpo: fundo de papel quente, cartões brancos com borda fina, texto escuro
        e a paleta usada só em detalhes (seleção, marcadores), para não cansar a vista.
    -->
    <color name="paper">#FAF8F3</color>
    <color name="card">#FFFFFF</color>
    <color name="line">#E8E2D6</color>
    <color name="line_strong">#D6CEBF</color>
    <color name="ink">#2E3335</color>
    <!-- Contraste mínimo (WCAG 2.1 AA): muted tem 5,4:1 sobre o papel; field_outline tem 3,7:1. -->
    <color name="muted">#5F676A</color>
    <color name="field_outline">#8C8475</color>
    <color name="accent_soft">#F6E5DB</color>
    <color name="surface">@color/paper</color>
    <color name="primary">@color/ink</color>
    <color name="logo_background">#333333</color>

    <style name="Theme.Clinica" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/ink</item>
        <item name="colorOnPrimary">@color/card</item>
        <item name="android:colorAccent">@color/ink</item>
        <item name="colorPrimaryContainer">@color/accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/ink</item>
        <item name="colorSecondary">@color/ink</item>
        <item name="colorSecondaryContainer">@color/accent_soft</item>
        <item name="colorOnSecondaryContainer">@color/ink</item>
        <item name="colorTertiary">@color/sage</item>
        <item name="android:colorControlActivated">@color/ink</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="colorSurface">@color/paper</item>
        <item name="colorSurfaceContainerLowest">@color/card</item>
        <item name="colorSurfaceContainerLow">@color/card</item>
        <item name="colorSurfaceContainer">@color/card</item>
        <item name="colorSurfaceContainerHigh">@color/card</item>
        <item name="colorSurfaceContainerHighest">@color/card</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOnBackground">@color/ink</item>
        <item name="colorOutline">@color/field_outline</item>
        <item name="colorOutlineVariant">@color/line</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <item name="textInputOutlinedStyle">@style/Widget.Clinica.TextInput</item>
        <item name="textInputOutlinedExposedDropdownMenuStyle">@style/Widget.Clinica.Dropdown</item>
        <item name="materialCardViewOutlinedStyle">@style/Widget.Clinica.Card</item>
        <item name="materialButtonStyle">@style/Widget.Clinica.Button</item>
        <item name="tabStyle">@style/Widget.Clinica.Tabs</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Clinica.Dialog</item>
        <item name="actionMenuTextAppearance">@style/TextAppearance.Clinica.Action</item>
        <item name="actionMenuTextColor">@color/ink</item>
        <item name="android:datePickerDialogTheme">@style/Theme.Clinica.Picker</item>
        <item name="android:timePickerDialogTheme">@style/Theme.Clinica.Picker</item>
    </style>

    <style name="Widget.Clinica.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/card</item>
        <item name="boxStrokeColor">@color/field_stroke</item>
        <item name="hintTextColor">@color/ink</item>
        <item name="shapeAppearance">@style/Shape.Clinica.Field</item>
    </style>

    <style name="Widget.Clinica.Dropdown"
        parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/card</item>
        <item name="boxStrokeColor">@color/field_stroke</item>
        <item name="hintTextColor">@color/ink</item>
        <item name="shapeAppearance">@style/Shape.Clinica.Field</item>
    </style>

    <style name="Shape.Clinica.Field" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Widget.Clinica.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/card</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.Clinica.Button" parent="Widget.Material3.Button">
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.Clinica.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="checkedIconTint">@color/ink</item>
    </style>

    <style name="Widget.Clinica.Tabs" parent="Widget.Material3.TabLayout">
        <item name="android:background">@color/paper</item>
        <item name="tabIndicatorColor">@color/ink</item>
        <item name="tabSelectedTextColor">@color/ink</item>
        <item name="tabTextColor">@color/muted</item>
        <item name="tabRippleColor">@color/accent_soft</item>
    </style>

    <style name="Widget.Clinica.Rail" parent="Widget.Material3.NavigationRailView">
        <item name="android:background">@color/paper</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Clinica.Rail.Indicator</item>
        <item name="itemIconTint">@color/ink</item>
        <item name="itemTextColor">@color/ink</item>
    </style>

    <style name="Widget.Clinica.Rail.Indicator" parent="Widget.Material3.NavigationRailView.ActiveIndicator">
        <item name="android:color">@color/accent_soft</item>
    </style>

    <style name="ThemeOverlay.Clinica.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurfaceContainerHigh">@color/card</item>
        <item name="colorPrimary">@color/ink</item>
    </style>

    <style name="TextAppearance.Clinica.Action" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.Clinica.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">serif</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Theme.Clinica.Picker" parent="android:Theme.Material.Light.Dialog">
        <item name="android:colorAccent">@color/slate</item>
        <item name="android:textColorPrimary">@color/ink</item>
    </style>
</resources>
